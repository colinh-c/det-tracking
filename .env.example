# Export only settings appropriate for your deployment. No passwords or keys.
DET_SSH_HOST=pi@raspberrypi.local
DET_SSH_HOST_KEY_ALIAS=
DET_PI_ROOT=/home/pi/gimbal
DET_MANUAL_GATEWAY=
DET_AUTO_GATEWAY=
# Pi gateway service environment only; this is not forwarded from the Mac.
DET_MOTOR_DEVICE=/dev/ttyACM0
# Required only for tools/reconnect_pi.py. Fill with your actual USB identities.
DET_USB_HOST_MAC=
DET_PI_LINK_LOCAL=
